PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://root:changeme@localhost:27017/budget-app?authSource=admin
CLIENT_ORIGIN=http://localhost:5173
# Placeholders: fine for development. With NODE_ENV=production the server
# refuses to start until both are long (32+ chars), random and different:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Mailpit (docker compose) catches all mail locally — inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Budget App <no-reply@budget-app.local>
# Production also requires SMTP_HOST, a real MAIL_FROM domain and a
# non-default database password in MONGO_URI.

# Behind a reverse proxy / load balancer, set how many proxy hops to trust
# (or the proxies' addresses, e.g. "loopback, 10.0.0.0/8") so login rate
# limits see the real client IP. Leave unset when clients connect directly:
# X-Forwarded-For is then ignored and can't be used to dodge the limits.
# TRUST_PROXY=1
